# Server Port (default 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Admin API token for remote kick/ban CLI access
ADMIN_TOKEN=

# AI bots per team at server start (default 10 => 10v10 match).
# When humans join, one bot is retired from that human's team to keep balance.
SERVER_BOT_COUNT=10

# Round length in minutes (default 30, minimum 30 in practice — the arena is
# 448m wide and a flag run crosses ~320m, so shorter rounds are mostly travel).
# When the clock runs out the team with more captures takes the round.
ROUND_MINUTES=30

# SSE fallback streams (/api/game/events). Each one registers a player, so they
# are bounded: a client that keeps losing the WebSocket can otherwise pile up
# ghost players. Once the caps are hit the endpoint answers 503.
SSE_MAX_SESSIONS=24
SSE_MAX_PER_IP=3

# Server-side movement validation (anti teleport / speed hack). Client positions
# are credited by elapsed time, so a modified client cannot jump to the enemy
# flag. Leave this on; only a harness that scripts long-range teleports on
# purpose (PHASE=all in scripts/beta-probe.mjs) sets "off".
MOVE_VALIDATION=on

# WebSocket limits. Every socket registers a player and every frame hits the
# 20Hz loop, so sockets are capped globally and per IP, and each socket gets a
# message budget (60/s sustained covers 20Hz input plus actions).
WS_MAX_CLIENTS=64

# Sockets allowed from a single IP address. This is a flood guard, not a seat
# quota: everyone behind one NAT shares one address, so an office, school, LAN
# party, mobile carrier (CGNAT) or a proxied preview all draw from the same
# budget. Set too low, a whole group on one network is locked out while the
# server sits idle. The tradeoff of raising it is that one abusive host can hold
# that many sockets at once; WS_MAX_CLIENTS stays the hard bound on total
# sockets, and so on server memory and tick time, whatever this is set to.
WS_MAX_PER_IP=32

WS_MSG_RATE=60
WS_MSG_BURST=120

# Honour X-Forwarded-For for client identity (per-IP caps, IP bans). That header
# is client-controlled, so enable it ONLY when the server really sits behind a
# reverse proxy (Caddy/Nginx/Render); direct exposure must leave it at 0 or the
# caps can be dodged by rotating fake IPs.
TRUST_PROXY=0
