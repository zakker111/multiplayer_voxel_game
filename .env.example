# Server Port (default 3000)
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Admin API token for remote kick/ban CLI access
ADMIN_TOKEN=

# AI bots per team at server start (default 10 => 10v10 match).
# When humans join, one bot is retired from that human's team to keep balance.
SERVER_BOT_COUNT=10
